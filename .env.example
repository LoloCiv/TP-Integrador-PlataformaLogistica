# Plantilla del .env: copiar este archivo como .env y completar los valores.
# El .env real NO se sube al repositorio (tiene contraseñas); este sí, para que se sepa
# qué variables necesita el proyecto.

# --- PostgreSQL ---
POSTGRES_USER=logistica
POSTGRES_PASSWORD=cambiar_esto
POSTGRES_DB=logistica
# "db" = nombre del servicio en docker-compose (dentro de la red de Docker)
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (cola de mensajes) ---
REDIS_URL=redis://redis:6379/0

# --- Autenticación (JWT) ---
# Clave para firmar los tokens. Generar una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambiar_esto
JWT_EXPIRA_MINUTOS=60
JWT_ALGORITMO=HS256

# --- CORS: orígenes que pueden llamar a la API desde un navegador (separados por coma) ---
CORS_ORIGINS=http://localhost:3000

# --- Logging: DEBUG, INFO, WARNING o ERROR ---
LOG_LEVEL=INFO
